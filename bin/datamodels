#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use ItkEnter\DataModels\Command\GenerateCommand;
use ItkEnter\DataModels\Command\ReleaseCommand;
use ItkEnter\DataModels\Command\SiteCheckCommand;
use ItkEnter\DataModels\Command\SitePrepareCommand;
use ItkEnter\DataModels\Command\ValidateCommand;
use ItkEnter\DataModels\Command\VendorUpdateCommand;
use Symfony\Component\Console\Application;

$repoRoot = dirname(__DIR__);

$application = new Application('itk-enter/data-models');
$application->addCommand(new ValidateCommand($repoRoot));
$application->addCommand(new VendorUpdateCommand($repoRoot));
$application->addCommand(new GenerateCommand($repoRoot));
$application->addCommand(new ReleaseCommand($repoRoot));
$application->addCommand(new SitePrepareCommand($repoRoot));
$application->addCommand(new SiteCheckCommand($repoRoot));

// model:new is registered here once it lands.

$application->run();
